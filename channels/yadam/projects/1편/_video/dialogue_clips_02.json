  "runtime_min": 42.6,
  "slots": 21,
  "items": [
    {
      "slot": 1,
      "at_min": 1.94,
      "para": 26,
      "speaker": null,
      "speaker_guess": "만석",
      "guess_evidence": "만석이 손가락으로 자루를 가리켰어요.",
      "dialogue": "\"온 고을이 굶었다. 나락 한 톨이 금값이었어. 그런데 네 집만 저걸 온전히 남겼다고?\"",
      "scene": null,
      "output": "dialogue_02_01.mp4",
      "status": "planned"
    },
    {
      "slot": 2,
      "at_min": 2.66,
      "para": 40,
      "speaker": null,
      "speaker_guess": "분이",
      "guess_evidence": "분이가 마루 끝으로 나앉았어요.",
      "dialogue": "\"우리 어머님이 섣달에 두 번 쓰러지셨습니다. 그때 제가 저 자루를 세 번 열었습니다.\"",
      "scene": null,
      "output": "dialogue_02_02.mp4",
      "status": "planned"
    },
    {
      "slot": 3,
      "at_min": 5.2,
      "para": 82,
      "speaker": null,
      "speaker_guess": "만석",
      "guess_evidence": "만석이 대답하지 못했습니다. 사립문을 걷어차고 나갔어요.",
      "dialogue": "\"관아에 가면 아저씨 씨오쟁이 이야기도 나옵니다. 그건 각오하고 가시는 겁니까.\"",
      "scene": null,
      "output": "dialogue_02_03.mp4",
      "status": "planned"
    },
    {
      "slot": 4,
      "at_min": 7.12,
      "para": 112,
      "speaker": null,
      "speaker_guess": "시어머니",
      "guess_evidence": "시어머니가 그 말에 아무 대답도 못 했습니다.",
      "dialogue": "\"내려놓으면 제가 먹을 것 같아서요.\"",
      "scene": null,
      "output": "dialogue_02_04.mp4",
      "status": "planned"
    },
    {
      "slot": 5,
      "at_min": 8.9,
      "para": 144,
      "speaker": null,
      "speaker_guess": "시어머니",
      "guess_evidence": "시어머니가 등잔 심지를 돋우었어요.",
      "dialogue": "\"내일 사또 앞에 서면 말을 짧게 해라. 길게 하면 지어낸 것처럼 들린다.\"",
      "scene": null,
      "output": "dialogue_02_05.mp4",
      "status": "planned"
    },
    {
      "slot": 6,
      "at_min": 11.19,
      "para": 180,
      "speaker": null,
      "speaker_guess": "만석",
      "guess_evidence": "만석이 먼저 나섰어요.",
      "dialogue": "\"저 여자 집만 씨오쟁이가 온전합니다. 온 동네가 다 비었는데 저 집만 그렇습니다.\"",
      "scene": null,
      "output": "dialogue_02_06.mp4",
      "status": "planned"
    },
    {
      "slot": 7,
      "at_min": 12.7,
      "para": 205,
      "speaker": null,
      "speaker_guess": null,
      "guess_evidence": null,
      "dialogue": "\"올해 것은 아직 나오지도 않았고, 재작년 것이면 빛이 죽습니다. 이건 딱 한 해 묵은 것입니다.\"",
      "scene": null,
      "output": "dialogue_02_07.mp4",
      "status": "planned"
    },
    {
      "slot": 8,
      "at_min": 15.7,
      "para": 253,
      "speaker": null,
      "speaker_guess": "분이",
      "guess_evidence": "분이가 사람들 쪽으로 돌아섰어요.",
      "dialogue": "\"저 자루가 제 것이라는 걸 말로 백 번 하는 것보다, 반을 내놓는 게 빠릅니다. 도둑이 훔친 걸 나눠 줍니까.\"",
      "scene": null,
      "output": "dialogue_02_08.mp4",
      "status": "planned"
    },
    {
      "slot": 9,
      "at_min": 16.09,
      "para": 257,
      "speaker": null,
      "speaker_guess": null,
      "guess_evidence": null,
      "dialogue": "\"그때 못 준 건 씨였고, 지금 주는 것도 씨입니다. 다만 지금은 심을 때라 드리는 겁니다.\"",
      "scene": null,
      "output": "dialogue_02_09.mp4",
      "status": "planned"
    },
    {
      "slot": 10,
      "at_min": 18.43,
      "para": 292,
      "speaker": null,
      "speaker_guess": "시어머니",
      "guess_evidence": "시어머니가 마당을 내려다보았습니다.",
      "dialogue": "\"그해에 우리 시아버님이 씨를 먹었다. 그다음 해에 우리 집이 빈 논을 봤어.\"",
      "scene": null,
      "output": "dialogue_02_10.mp4",
      "status": "planned"
    },
    {
      "slot": 11,
      "at_min": 21.44,
      "para": 339,
      "speaker": null,
      "speaker_guess": null,
      "guess_evidence": null,
      "dialogue": "\"열두 집에 두 되씩 스물넉 되가 나갔습니다. 관에서 내려온 건 그다음 달입니다.\"",
      "scene": null,
      "output": "dialogue_02_11.mp4",
      "status": "planned"
    },
    {
      "slot": 12,
      "at_min": 22.43,
      "para": 351,
      "speaker": null,
      "speaker_guess": "분이",
      "guess_evidence": "분이가 웃었어요. 그날 처음으로 웃었습니다.",
      "dialogue": "\"그러니까 우리가 심는 거하고 댁이 심는 거하고, 따지고 보면 한 논이오.\"",
      "scene": null,
      "output": "dialogue_02_12.mp4",
      "status": "planned"
    },
    {
      "slot": 13,
      "at_min": 25.86,
      "para": 405,
      "speaker": null,
      "speaker_guess": "만석",
      "guess_evidence": "만석이 제 손을 내려다보았습니다.",
      "dialogue": "\"그래서 열두 집을 돌았다. 한 집에서 조금씩만 퍼내면 모를 줄 알았지.\"",
      "scene": null,
      "output": "dialogue_02_13.mp4",
      "status": "planned"
    },
    {
      "slot": 14,
      "at_min": 27.06,
      "para": 423,
      "speaker": null,
      "speaker_guess": "만석",
      "guess_evidence": "만석이 엽전 꾸러미를 손으로 눌렀어요.",
      "dialogue": "\"우리 어머님이 그날 두 번 쓰러지려는 걸 제가 붙들었습니다. 그건 아저씨가 못 갚습니다.\"",
      "scene": null,
      "output": "dialogue_02_14.mp4",
      "status": "planned"
    },
    {
      "slot": 15,
      "at_min": 28.28,
      "para": 444,
      "speaker": null,
      "speaker_guess": "분이",
      "guess_evidence": "분이가 일어섰어요.",
      "dialogue": "\"논에 물 대는 도랑이 하나입니다. 저는 도둑이 판 도랑 물로 제 모를 못 키웁니다.\"",
      "scene": null,
      "output": "dialogue_02_15.mp4",
      "status": "planned"
    },
    {
      "slot": 16,
      "at_min": 30.29,
      "para": 477,
      "speaker": null,
      "speaker_guess": "분이",
      "guess_evidence": "분이가 사람들 사이를 지나갔어요.",
      "dialogue": "\"저는 저 사람 일에 손을 안 댈 겁니다. 미운 것도 제 몫이고, 안 미운 것도 제 몫입니다.\"",
      "scene": null,
      "output": "dialogue_02_16.mp4",
      "status": "planned"
    },
    {
      "slot": 17,
      "at_min": 32.73,
      "para": 514,
      "speaker": null,
      "speaker_guess": null,
      "guess_evidence": null,
      "dialogue": "\"아닙니다. 위에서부터 차례로 대야 물이 고릅니다.\"",
      "scene": null,
      "output": "dialogue_02_17.mp4",
      "status": "planned"
    },
    {
      "slot": 18,
      "at_min": 34.09,
      "para": 535,
      "speaker": null,
      "speaker_guess": null,
      "guess_evidence": null,
      "dialogue": "\"바람이 불어도 아무 소리가 안 나더라. 그게 그렇게 무섭더구나.\"",
      "scene": null,
      "output": "dialogue_02_18.mp4",
      "status": "planned"
    },
    {
      "slot": 19,
      "at_min": 37.13,
      "para": 594,
      "speaker": null,
      "speaker_guess": null,
      "guess_evidence": null,
      "dialogue": "\"저 사람 논에 물이 안 들면 그 아래 우리 논도 마릅니다. 도랑이 하나라서요.\"",
      "scene": null,
      "output": "dialogue_02_19.mp4",
      "status": "planned"
    },
    {
      "slot": 20,
      "at_min": 38.06,
      "para": 605,
      "speaker": null,
      "speaker_guess": "만석",
      "guess_evidence": "만석이 논둑 아래를 손으로 가리켰어요.",
      "dialogue": "\"저쪽은 물이 잘 빠지니 늦모를 내도 됩니다.\"",
      "scene": null,
      "output": "dialogue_02_20.mp4",
      "status": "planned"
    },
    {
      "slot": 21,
      "at_min": 40.7,
      "para": 644,
      "speaker": null,
      "speaker_guess": "분이",
      "guess_evidence": "분이가 자루 아가리를 풀어 보았어요. 볍씨가 알이 굵었지요.",
      "dialogue": "\"용서는 안 했습니다. 그런데 이건 씨입니다.\"",
      "scene": null,
      "output": "dialogue_02_21.mp4",
      "status": "planned"
    }
  ]
}